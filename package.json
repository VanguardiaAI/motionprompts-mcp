  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "homepage": "https://motionprompts.dev/developers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanguardiaAI/motionprompts-mcp.git"
  },
  "bin": {
    "motionprompts-mcp": "mcp/server.mjs"
  },
